            android:name=".Lap1_1Activity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 2. Màn hình Danh sách sinh viên -->
        <activity
            android:name=".Lap1_2Activity"
            android:exported="false" />

        <!-- 3. Màn hình Chi tiết sinh viên (Lab 3) -->
        <activity
            android:name=".Lap3Activity"
            android:exported="false" />

    </application>

</manifest>